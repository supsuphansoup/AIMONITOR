# AIMONITOR configuration. Copy to `.env` and edit; every value has a safe default.
# .env is gitignored - never commit real keys.

# --- Identity -----------------------------------------------------------
PROJECT_NAME=AIMONITOR
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Storage ------------------------------------------------------------
# Four slashes means an absolute path: sqlite:////app/data/aimonitor.db
DATABASE_URL=sqlite:///./aimonitor.db

# --- Authentication -----------------------------------------------------
# REQUIRED before exposing this server beyond localhost. Unset means every
# endpoint is open, and the server warns about it at startup.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Set true before exposing this server beyond localhost, so reads are protected too.
REQUIRE_AUTH_FOR_READS=false

# --- CORS ---------------------------------------------------------------
# Comma-separated, or a JSON array. "*" disables credentialed requests, which
# browsers reject alongside a wildcard origin anyway.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Browser protection ---------------------------------------------------
# Writes carrying a browser Origin outside CORS_ORIGINS are always refused.
# With or without API_KEY only localhost / 127.0.0.1 / [::1] host names are answered
# (DNS-rebinding defence). Comma-separated extra host names for a trusted network:
ALLOWED_HOSTS=

# --- Ingestion limits ---------------------------------------------------
MAX_BATCH_SIZE=500
# Checked against Content-Length and received chunks before JSON buffering.
MAX_REQUEST_BYTES=8388608
MAX_ERROR_MESSAGE_CHARS=2000
MAX_METADATA_BYTES=8192
MAX_TAGS=20

# --- Aggregation --------------------------------------------------------
# Percentiles are computed from at most this many rows; beyond it the API
# reports latency_sampled=true rather than pretending to be exact.
MAX_AGGREGATION_ROWS=200000

# --- Background jobs ----------------------------------------------------
SCHEDULER_ENABLED=true
# How often alert rules are evaluated. Each rule still honours its own cooldown.
ALERT_INTERVAL_SECONDS=60
ALERT_ALLOW_PRIVATE_WEBHOOKS=false
# 0 keeps data forever. Set e.g. 90 to drop traces older than 90 days.
# The cutoff must remain in year 1 or later; out-of-range settings are rejected.
RETENTION_DAYS=0
RETENTION_INTERVAL_SECONDS=3600
